{
  "name": "ai-influencer",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "automation:report": "node scripts/automation-cost.mjs",
    "video:export": "node scripts/edit/export.mjs",
    "clip:auto": "node scripts/clip/clip.mjs auto",
    "clip:fetch": "node scripts/clip/clip.mjs fetch",
    "clip:moments": "node scripts/clip/clip.mjs moments",
    "clip:cut": "node scripts/clip/clip.mjs cut",
    "clip:mark": "node scripts/clip/clip.mjs mark",
    "clip:live": "node scripts/clip/live.mjs live",
    "clip:live-cut": "node scripts/clip/live.mjs live-cut",
    "doctor": "node scripts/doctor.mjs",
    "setup:mac": "bash scripts/setup-mac.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "dev": "pnpm --filter @ai-influencer/panel dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @ai-influencer/panel start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm test:scripts",
    "test:e2e": "pnpm --filter @ai-influencer/panel test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "supabase:db-reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "owner:create": "pnpm --filter @ai-influencer/panel run owner:create",
    "workspace:create": "pnpm --filter @ai-influencer/panel run workspace:create",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:integration:worker": "node --test --test-concurrency=1 scripts/session-claim.integration.test.mjs apps/worker/src/integration.test.ts apps/worker/src/explainer.integration.test.ts",
    "panel": "node scripts/panel.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:storage": "node scripts/backup-storage.mjs",
    "backup:storage:verify": "node scripts/backup-storage.mjs verify",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "env:pull": "node scripts/env-pull.mjs",
    "release": "node scripts/release.mjs",
    "codemap": "node scripts/codemap.mjs",
    "worker:doctor": "node apps/worker/src/doctor.ts",
    "mcp:start": "node apps/mcp/src/cli.ts start",
    "mcp:login": "node apps/mcp/src/cli.ts login",
    "mcp:logout": "node apps/mcp/src/cli.ts logout",
    "mcp:status": "node apps/mcp/src/cli.ts status",
    "test:integration:mcp": "pnpm --filter @ai-influencer/mcp run test:integration",
    "worker:start": "node apps/worker/src/cli.ts start",
    "worker:login": "node apps/worker/src/cli.ts login",
    "worker:logout": "node apps/worker/src/cli.ts logout",
    "worker:status": "node apps/worker/src/cli.ts status",
    "worker:selftest": "node apps/worker/src/cli.ts selftest",
    "worker:produce-local": "node apps/worker/src/produce-local.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3"
  }
}
