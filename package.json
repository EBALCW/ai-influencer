{
  "name": "ai-influencer",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "setup:mac": "bash scripts/setup-mac.sh",
    "setup:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "dev": "pnpm --filter @ai-influencer/panel dev",
    "build": "pnpm -r --if-present run build",
    "start": "pnpm --filter @ai-influencer/panel start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm test:scripts",
    "test:e2e": "pnpm --filter @ai-influencer/panel test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "supabase:db-reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "owner:create": "pnpm --filter @ai-influencer/panel run owner:create",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "panel": "node scripts/panel.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "env:pull": "node scripts/env-pull.mjs",
    "release": "node scripts/release.mjs",
    "codemap": "node scripts/codemap.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "shadcn": "4.22.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3"
  }
}
