# Kopyası .env.local olarak oluşturulur (setup script'i otomatik yapar).
# Gerçek değerler parola yöneticisinden alınır. Bu dosyaya gerçek anahtar YAZMA.

# Supabase (ortak dev projesi)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram (Meta for Developers)
META_APP_ID=
META_APP_SECRET=

# YouTube (Google Cloud OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI sağlayıcıları
HIGGSFIELD_API_KEY=
ANTHROPIC_API_KEY=
