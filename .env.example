# Kopyası .env.local olarak oluşturulur (setup script'i otomatik yapar).
# Gerçek değerler ekip parola yöneticisinden alınır. Bu dosyaya gerçek anahtar YAZMA.

# Supabase
# - Önerilen: ortak "dev" Supabase projesinin değerleri (Docker gerekmez)
# - Alternatif: yerel Supabase (Docker gerekir) -> `pnpm supabase:start`, değerler `pnpm supabase:status` ile görünür
#   Yerel URL: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucu tarafı. Tarayıcı koduna (NEXT_PUBLIC_*) asla taşıma.
SUPABASE_SERVICE_ROLE_KEY=
# Sadece `pnpm backup` için: Project Settings -> Database -> Connection string (Session pooler, URI).
# Veritabanı şifresini içerir. Sadece yedek alan kişinin bilgisayarında doldur.
SUPABASE_DB_URL=

# Instagram (Meta for Developers) - #49
META_APP_ID=
META_APP_SECRET=

# YouTube (Google Cloud OAuth) - #49
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers - #49
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI sağlayıcıları - #47, #48
# Görsel/video üretim sağlayıcısı: mock (varsayılan, ağ çağrısı yok) | higgsfield. Bkz. docs/adr/0002-generation-provider.md
GENERATION_PROVIDER=
# Higgsfield Cloud API anahtarı (cloud.higgsfield.ai). ID ve secret ayrı; sadece sunucuda okunur.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Model kimlikleri hesaba göre değişir (console.higgsfield.ai). Ör. higgsfield-ai/soul/v2/standard, higgsfield/genjutsu/motion-transfer/v1.0
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_VIDEO_TO_VIDEO_MODEL=
ANTHROPIC_API_KEY=
# Opsiyonel. Boşsa claude-opus-5-5 kullanılır. İleride app_settings tablosuna taşınacak (#48).
ANTHROPIC_MODEL=
