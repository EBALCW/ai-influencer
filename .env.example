# Kopyası .env.local olarak oluşturulur (setup script'i otomatik yapar).
# Gerçek değerler ekip parola yöneticisinden alınır. Bu dosyaya gerçek anahtar YAZMA.

# Supabase
# - Önerilen: ortak "dev" Supabase projesinin değerleri (Docker gerekmez)
# - Alternatif: yerel Supabase (Docker gerekir) -> `pnpm supabase:start`, değerler `pnpm supabase:status` ile görünür
#   Yerel URL: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# Yeni Supabase projelerinde publishable key kullanın; eski projelerde anon key kabul edilir.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Panelin kök URL'si; Supabase Auth > URL Configuration'da callback izinli olmalı.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sadece sunucu tarafı. Tarayıcı koduna (NEXT_PUBLIC_*) asla taşıma.
SUPABASE_SERVICE_ROLE_KEY=

# Instagram (Meta for Developers) - #49
META_APP_ID=
META_APP_SECRET=

# YouTube (Google Cloud OAuth) - #49
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers - #49
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI sağlayıcıları - #47, #48
HIGGSFIELD_API_KEY=
ANTHROPIC_API_KEY=
