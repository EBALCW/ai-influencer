# Kopyası .env.local olarak oluşturulur (setup script'i otomatik yapar).
# Gerçek değerler ekip parola yöneticisinden alınır. Bu dosyaya gerçek anahtar YAZMA.

# Supabase
# - Önerilen: ortak "dev" Supabase projesinin değerleri (Docker gerekmez)
# - Alternatif: yerel Supabase (Docker gerekir) -> `pnpm supabase:start`, değerler `pnpm supabase:status` ile görünür
#   Yerel URL: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucu tarafı. Tarayıcı koduna (NEXT_PUBLIC_*) asla taşıma.
SUPABASE_SERVICE_ROLE_KEY=
# Sadece `pnpm backup` için: Project Settings -> Database -> Connection string (Session pooler, URI).
# Veritabanı şifresini içerir. Sadece yedek alan kişinin bilgisayarında doldur.
SUPABASE_DB_URL=

# Instagram (Meta for Developers) - #49
META_APP_ID=
META_APP_SECRET=

# YouTube (Google Cloud OAuth) - #49
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers - #49
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# AI sağlayıcıları - #47, #48
# Panelden açılan üretimlerin generations.tool değeri (varsayılan higgsfield). Kuyruk worker'ı sadece yapılandırılmış sağlayıcının işlerini alır. Bkz. docs/adr/0002-generation-provider.md
GENERATION_PROVIDER=
# Higgsfield Cloud API anahtarı (cloud.higgsfield.ai). ID ve secret ayrı; sadece sunucuda okunur.
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_KEY_SECRET=
# Model kimlikleri hesaba göre değişir (console.higgsfield.ai). Ör. higgsfield-ai/soul/v2/standard, higgsfield/genjutsu/motion-transfer/v1.0
HIGGSFIELD_IMAGE_MODEL=
HIGGSFIELD_VIDEO_TO_VIDEO_MODEL=
# Image-to-video modeli doğrulanmadı (ADR 0002 açık soru); boşsa bu moddaki işler "yapılandırılmamış" hatasıyla biter.
HIGGSFIELD_IMAGE_TO_VIDEO_MODEL=
# Kuyruk worker'ı (supabase/functions/process-generations) bu değerleri .env.local'dan DEĞİL,
# `supabase secrets set` ile Edge Function secret'ı olarak okur: HIGGSFIELD_API_KEY_ID/SECRET,
# HIGGSFIELD_*_MODEL, CRON_SECRET ve isteğe bağlı GENERATION_RUNNING_TIMEOUT_MINUTES (varsayılan 30).
GENERATION_RUNNING_TIMEOUT_MINUTES=

# Yayın kuyruğu (#58) - supabase/functions/publish-scheduled. Bunlar da .env.local'dan DEĞİL,
# `supabase secrets set` ile Edge Function secret'ı olarak okunur (hepsi isteğe bağlı; CRON_SECRET ortak).
# YouTube gizlilik durumu: public (varsayılan) | unlisted | private. Denetimden geçmemiş Google API projesinde YouTube yüklemeyi private kilitler.
YOUTUBE_PRIVACY_STATUS=
# Instagram Graph API sürümü (ör. v23.0). Boşsa koddaki varsayılan.
INSTAGRAM_GRAPH_VERSION=
# Final video üst sınırı (bayt). Boşsa 104857600 (assets bucket sınırı).
PUBLISH_MAX_VIDEO_BYTES=
ANTHROPIC_API_KEY=
# Model ve token fiyatları panelde Ayarlar → AI bölümünden yönetilir.

# Sosyal OAuth. Yalnız sunucuda; base yalnız origin (path/query yok).
# YouTube için localhost HTTP kabul edilir; TikTok Web HTTPS dönüş adresi ister.
OAUTH_REDIRECT_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# TikTok portalındaki client_key, bu değişkene girilir.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
